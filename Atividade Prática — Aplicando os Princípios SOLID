using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;


class Pedido
{
    public string Cliente;
    public double ValorTotal;
}

interface IDesconto
{
    double AplicarDesconto(double valor);
}

interface INotificacao
{
    void Enviar(string cliente);
}

interface IPedidoRepository
{
    void Salvar(Pedido pedido);
}

interface IRelatorioPedido
{
    void Gerar(Pedido pedido);
}


// DESCONTO

class DescontoSimples : IDesconto
{
    public double AplicarDesconto(double valor)
    {
        Console.WriteLine("Aplicando 10% de desconto...");
        return valor - (valor * 0.10);
    }
}


// NOTIFICAÇÃO

class EmailService : INotificacao
{
    public void Enviar(string cliente)
    {
        Console.WriteLine("Enviando email para " + cliente);
    }
}


// REPOSITÓRIO

class PedidoRepository : IPedidoRepository
{
    public void Salvar(Pedido pedido)
    {
        Console.WriteLine("Salvando pedido no sistema...");
    }
}


// RELATÓRIO

class RelatorioPedido : IRelatorioPedido
{
    public void Gerar(Pedido pedido)
    {
        Console.WriteLine("----- RELATÓRIO -----");
        Console.WriteLine("Cliente: " + pedido.Cliente);
        Console.WriteLine("Valor Final: R$ " + pedido.ValorTotal);
    }
}


// SERVIÇO PRINCIPAL

class PedidoService
{
    private IDesconto desconto;
    private INotificacao notificacao;
    private IPedidoRepository repository;
    private IRelatorioPedido relatorio;

    public PedidoService(IDesconto d, INotificacao n, IPedidoRepository r, IRelatorioPedido rel)
    {
        desconto = d;
        notificacao = n;
        repository = r;
        relatorio = rel;
    }

    public void ProcessarPedido(Pedido pedido)
    {
        pedido.ValorTotal = desconto.AplicarDesconto(pedido.ValorTotal);
        repository.Salvar(pedido);
        notificacao.Enviar(pedido.Cliente);
        relatorio.Gerar(pedido);

        Console.WriteLine("Pedido finalizado!");
    }
}


// PROGRAMA

class Program
{
    static void Main(string[] args)
    {
        Pedido pedido = new Pedido();
        pedido.Cliente = "Maria";
        pedido.ValorTotal = 1000;

        IDesconto desconto = new DescontoSimples();
        INotificacao notificacao = new EmailService();
        IPedidoRepository repository = new PedidoRepository();
        IRelatorioPedido relatorio = new RelatorioPedido();

        PedidoService service = new PedidoService(
            desconto,
            notificacao,
            repository,
            relatorio
        );

        service.ProcessarPedido(pedido);

        Console.ReadLine();
    }
}
